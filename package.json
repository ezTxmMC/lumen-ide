{
  "name": "lumen-ide",
  "version": "0.5.2",
  "description": "Lumen — eine moderne, leichtgewichtige IDE mit einfachem Add-on-System",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Lumen",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder",
    "dist:linux": "vite build && electron-builder --linux --x64",
    "dist:linux:arm64": "vite build && electron-builder --linux --arm64",
    "dist:win": "vite build && electron-builder --win --x64 --arm64",
    "dist:win:x64": "vite build && electron-builder --win --x64",
    "dist:win:arm64": "vite build && electron-builder --win --arm64",
    "dist:mac": "vite build && electron-builder --mac zip --arm64",
    "dist:mac:dmg": "vite build && electron-builder --mac --arm64",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "build:ext": "node extensions/build.mjs",
    "test:extensions": "node scripts/test-extensions.mjs",
    "publish:ext": "node extensions/publish.mjs",
    "server:ext": "node extension-server/src/main.js",
    "test:server": "node extension-server/test/run.js",
    "check:languages": "esbuild scripts/check-languages.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-languages.mjs --log-level=error && node node_modules/.cache/check-languages.mjs",
    "check:project": "esbuild scripts/check-project.ts --bundle --platform=node --format=esm --alias:@=./src --external:electron --outfile=node_modules/.cache/check-project.mjs --log-level=error && node node_modules/.cache/check-project.mjs",
    "check:lsp": "esbuild scripts/check-lsp.ts --bundle --platform=node --format=esm --alias:@=./src --external:electron --outfile=node_modules/.cache/check-lsp.mjs --log-level=error && node node_modules/.cache/check-lsp.mjs",
    "check:themes": "esbuild scripts/check-themes.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-themes.mjs --log-level=error && node node_modules/.cache/check-themes.mjs",
    "check:dap": "esbuild scripts/check-dap.ts --bundle --platform=node --format=cjs --alias:@=./src --external:electron --outfile=node_modules/.cache/check-dap.cjs --log-level=error && node node_modules/.cache/check-dap.cjs",
    "check:completion": "esbuild scripts/check-completion.ts --bundle --platform=node --format=esm --alias:@=./src --external:electron --outfile=node_modules/.cache/check-completion.mjs --log-level=error && node node_modules/.cache/check-completion.mjs",
    "check:i18n": "esbuild scripts/check-i18n.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-i18n.mjs --log-level=error && node node_modules/.cache/check-i18n.mjs",
    "check:media": "esbuild scripts/check-media.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-media.mjs --log-level=error && node node_modules/.cache/check-media.mjs",
    "check:layout": "esbuild scripts/check-layout.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-layout.mjs --log-level=error && node node_modules/.cache/check-layout.mjs",
    "check:menubar": "esbuild scripts/check-menubar.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-menubar.mjs --log-level=error && node node_modules/.cache/check-menubar.mjs",
    "check:addons": "esbuild scripts/check-addons.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-addons.mjs --log-level=error && node node_modules/.cache/check-addons.mjs",
    "check:files": "esbuild scripts/check-files.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-files.mjs --log-level=error && node node_modules/.cache/check-files.mjs",
    "check:merge": "esbuild scripts/check-merge.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-merge.mjs --log-level=error && node node_modules/.cache/check-merge.mjs",
    "check": "npm run typecheck && npm run build:ext && npm run check:languages && npm run check:project && npm run check:lsp && npm run check:i18n && npm run check:completion && npm run check:themes && npm run check:layout && npm run check:menubar && npm run check:files && npm run check:media && npm run check:addons && npm run check:merge && npm run check:extensions && npm run check:docs && npm run test:server && npm run test:extensions",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "check:extensions": "esbuild scripts/check-extensions.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/check-extensions.mjs --log-level=error && node node_modules/.cache/check-extensions.mjs",
    "check:docs": "esbuild scripts/check-docs.ts --bundle --platform=node --format=esm --alias:@=./src --external:electron --outfile=node_modules/.cache/check-docs.mjs --log-level=error && node node_modules/.cache/check-docs.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "de.lumen.ide",
    "productName": "Lumen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableArgs": [
        "--ozone-platform-hint=auto",
        "--use-angle=vulkan",
        "--enable-features=WaylandWindowDecorations,WaylandPerSurfaceScale,WaylandUiScale",
        "--enable-wayland-ime",
        "--wayland-text-input-version=3"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "files": [
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/darwin-*/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "files": [
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/win32-*/**"
      ]
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.4.2": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  }
}
