{
  "languages": [
    {
      "id": "kotlin",
      "name": "Kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ],
      "icon": "Kt",
      "color": "#a97bff",
      "capitalizedAsType": true,
      "comments": {
        "line": "//",
        "block": [
          "/*",
          "*/"
        ]
      },
      "controls": [
        "if",
        "else",
        "for",
        "while",
        "do",
        "when",
        "break",
        "continue",
        "return",
        "throw",
        "try",
        "catch",
        "finally"
      ],
      "keywords": [
        "fun",
        "val",
        "var",
        "class",
        "object",
        "interface",
        "enum",
        "data",
        "sealed",
        "annotation",
        "companion",
        "constructor",
        "init",
        "this",
        "super",
        "package",
        "import",
        "typealias",
        "is",
        "as",
        "in",
        "out",
        "by",
        "where",
        "private",
        "protected",
        "public",
        "internal",
        "open",
        "abstract",
        "override",
        "final",
        "lateinit",
        "const",
        "inline",
        "noinline",
        "crossinline",
        "reified",
        "suspend",
        "operator",
        "infix",
        "tailrec",
        "external",
        "vararg",
        "expect",
        "actual",
        "value"
      ],
      "types": [
        "Int",
        "Long",
        "Short",
        "Byte",
        "Float",
        "Double",
        "Boolean",
        "Char",
        "String",
        "Unit",
        "Any",
        "Nothing",
        "Array",
        "IntArray",
        "ByteArray",
        "List",
        "MutableList",
        "ArrayList",
        "Map",
        "MutableMap",
        "HashMap",
        "Set",
        "MutableSet",
        "HashSet",
        "Pair",
        "Triple",
        "Sequence",
        "Result",
        "Flow",
        "StateFlow",
        "SharedFlow",
        "Deferred",
        "Job",
        "CoroutineScope",
        "Dispatchers",
        "Channel",
        "Iterable",
        "Iterator",
        "Collection",
        "Comparable",
        "Throwable",
        "Exception",
        "Regex",
        "StringBuilder",
        "Lazy",
        "KClass",
        "Enum",
        "Number"
      ],
      "builtins": [
        "println",
        "print",
        "readLine",
        "listOf",
        "mutableListOf",
        "mapOf",
        "mutableMapOf",
        "setOf",
        "arrayOf",
        "let",
        "run",
        "apply",
        "also",
        "with",
        "lazy",
        "require",
        "check",
        "runCatching",
        "launch",
        "async",
        "delay"
      ],
      "constants": [
        "true",
        "false",
        "null",
        "it",
        "this",
        "field"
      ],
      "strings": [
        {
          "start": "\"\"\"",
          "end": "\"\"\"",
          "multiline": true,
          "escapes": false
        },
        {
          "start": "\"",
          "escapes": true
        },
        {
          "start": "'",
          "escapes": true
        }
      ],
      "meta": "^@[A-Za-z]\\w*",
      "indentUnit": 4,
      "snippets": [
        {
          "label": "main",
          "detail": "main",
          "body": "fun main() {\n    $0\n}"
        },
        {
          "label": "data",
          "detail": "Data-Klasse",
          "body": "data class ${Name}(val ${feld}: ${String})"
        },
        {
          "label": "when",
          "detail": "when-Ausdruck",
          "body": "when (${wert}) {\n    ${1} -> $0\n    else -> {}\n}"
        },
        {
          "label": "class",
          "detail": "Klasse",
          "body": "class ${Name}(private val ${feld}: ${String}) {\n    $0\n}"
        },
        {
          "label": "obj",
          "detail": "Singleton",
          "body": "object ${Name} {\n    $0\n}"
        },
        {
          "label": "iface",
          "detail": "Interface",
          "body": "interface ${Name} {\n    fun ${methode}()$0\n}"
        },
        {
          "label": "sealed",
          "detail": "Sealed Class",
          "body": "sealed class ${Name} {\n    data class ${A}(val ${wert}: ${String}) : ${Name}()\n    object ${B} : ${Name}()$0\n}"
        },
        {
          "label": "enum",
          "detail": "Enum",
          "body": "enum class ${Name}(val ${text}: String) {\n    ${EINS}(\"${eins}\"),\n    ${ZWEI}(\"${zwei}\");$0\n}"
        },
        {
          "label": "ext",
          "detail": "Erweiterungsfunktion",
          "body": "fun ${String}.${name}(): ${String} {\n    $0\n}"
        },
        {
          "label": "susp",
          "detail": "suspend-Funktion",
          "body": "suspend fun ${name}(): ${String} {\n    $0\n}"
        },
        {
          "label": "scope",
          "detail": "coroutineScope",
          "body": "coroutineScope {\n    launch {\n        $0\n    }\n}"
        },
        {
          "label": "try",
          "detail": "runCatching",
          "body": "runCatching {\n    $0\n}.onFailure { println(it) }"
        },
        {
          "label": "test",
          "detail": "Test",
          "body": "@Test\nfun `${sollte etwas tun}`() {\n    $0\n}"
        }
      ],
      "run": [
        {
          "label": "kotlinc + java",
          "command": "kotlinc",
          "args": [
            "${file}",
            "-include-runtime",
            "-d",
            "${fileStem}.jar"
          ],
          "then": {
            "command": "java",
            "args": [
              "-jar",
              "${fileStem}.jar"
            ]
          }
        },
        {
          "label": "Kotlin-Script",
          "command": "kotlin",
          "args": [
            "${file}"
          ]
        },
        {
          "label": "Gradle",
          "command": "./gradlew",
          "args": [
            "run"
          ]
        }
      ],
      "lsp": [
        {
          "label": "kotlin-language-server",
          "command": "kotlin-language-server",
          "args": [],
          "candidates": [
            "~/.local/share/nvim/mason/bin/kotlin-language-server",
            "~/.local/share/kotlin-language-server/bin/kotlin-language-server",
            "~/.lumen/lsp/kotlin-language-server/bin/kotlin-language-server",
            "/opt/homebrew/bin/kotlin-language-server",
            "/usr/local/bin/kotlin-language-server"
          ],
          "languageId": "kotlin",
          "rootMarkers": [
            "build.gradle.kts",
            "build.gradle",
            "settings.gradle.kts",
            "settings.gradle",
            "pom.xml",
            ".git"
          ],
          "settings": {
            "kotlin": {
              "compiler": {
                "jvm": {
                  "target": "17"
                }
              },
              "indexing": {
                "enabled": true
              },
              "inlayHints": {
                "typeHints": true,
                "parameterHints": true,
                "chainedHints": true
              },
              "externalSources": {
                "useKlsScheme": false,
                "autoConvertToKotlin": false
              },
              "completion": {
                "snippets": {
                  "enabled": true
                }
              }
            }
          },
          "install": "Arch: yay -S kotlin-language-server · macOS: brew install kotlin-language-server · sonst https://github.com/fwcd/kotlin-language-server",
          "package": {
            "type": "github",
            "repo": "fwcd/kotlin-language-server",
            "bin": "bin/kotlin-language-server",
            "assets": {
              "linux-x64": "^server\\.zip$",
              "linux-arm64": "^server\\.zip$",
              "darwin-x64": "^server\\.zip$",
              "darwin-arm64": "^server\\.zip$",
              "win32-x64": "^server\\.zip$",
              "win32-arm64": "^server\\.zip$"
            }
          },
          "systemPackages": {
            "brew": "kotlin-language-server"
          },
          "installCommands": {
            "darwin": "brew install kotlin-language-server"
          },
          "docs": "https://github.com/fwcd/kotlin-language-server",
          "rootSearch": "outermost"
        },
        {
          "label": "kotlin-lsp (JetBrains)",
          "command": "kotlin-lsp",
          "args": [
            "--stdio"
          ],
          "candidates": [
            "~/.local/share/kotlin-lsp/kotlin-lsp.sh",
            "~/.lumen/lsp/kotlin-lsp/kotlin-lsp.sh"
          ],
          "languageId": "kotlin",
          "rootMarkers": [
            "build.gradle.kts",
            "settings.gradle.kts",
            ".git"
          ],
          "install": "https://github.com/Kotlin/kotlin-lsp — Archiv entpacken, kotlin-lsp.sh in den PATH",
          "docs": "https://github.com/Kotlin/kotlin-lsp",
          "rootSearch": "outermost"
        }
      ],
      "debug": [
        "kotlin-debug"
      ]
    }
  ],
  "themes": [],
  "commands": [],
  "events": [],
  "templates": [],
  "projectKinds": [],
  "snippets": []
}
