{
  "languages": [
    {
      "id": "astro",
      "name": "Astro",
      "extensions": [
        ".astro"
      ],
      "icon": "As",
      "color": "#ff5d01",
      "comments": {
        "block": [
          "<!--",
          "-->"
        ]
      },
      "indentOpen": "<(?!\\/|.*\\/>)[^>]*>\\s*$|[{[(]\\s*$",
      "indentClose": "^\\s*(?:<\\/|[}\\])])",
      "completions": [
        "Astro",
        "Astro.props",
        "Astro.params",
        "Astro.request",
        "Astro.url",
        "Astro.redirect",
        "Astro.cookies",
        "Astro.locals",
        "Astro.site",
        "Astro.slots",
        "Astro.glob",
        "getStaticPaths",
        "getCollection",
        "getEntry",
        "defineCollection",
        "z",
        "prerender",
        "client:load",
        "client:idle",
        "client:visible",
        "client:media",
        "client:only",
        "server:defer",
        "set:html",
        "set:text",
        "is:inline",
        "is:raw",
        "transition:name",
        "transition:animate",
        "transition:persist",
        "define:vars"
      ],
      "snippets": [
        {
          "label": "page",
          "detail": "Seite mit Frontmatter",
          "body": "---\nimport Layout from '${../layouts/Layout.astro}'\n\nconst ${titel} = '${Seite}'\n---\n\n<Layout title={${titel}}>\n  $0\n</Layout>"
        },
        {
          "label": "comp",
          "detail": "Komponente mit Props",
          "body": "---\ninterface Props {\n  ${titel}: ${string}\n}\n\nconst { ${titel} } = Astro.props\n---\n\n<div>{${titel}}</div>$0"
        },
        {
          "label": "paths",
          "detail": "getStaticPaths",
          "body": "export async function getStaticPaths() {\n  const ${einträge} = await getCollection('${blog}')\n  return ${einträge}.map((eintrag) => ({\n    params: { slug: eintrag.slug },\n    props: { eintrag },\n  }))\n}$0"
        },
        {
          "label": "coll",
          "detail": "Content-Collection",
          "body": "import { defineCollection, z } from 'astro:content'\n\nconst ${blog} = defineCollection({\n  type: 'content',\n  schema: z.object({\n    titel: z.string(),\n    datum: z.date(),\n  }),\n})\n\nexport const collections = { ${blog} }$0"
        },
        {
          "label": "island",
          "detail": "Insel mit Hydration",
          "body": "<${Komponente} client:visible ${prop}={${wert}} />$0"
        },
        {
          "label": "map",
          "detail": "Liste rendern",
          "body": "{${liste}.map((${element}) => (\n  <li>{${element}.${titel}}</li>\n))}$0"
        },
        {
          "label": "style",
          "detail": "Style-Block",
          "body": "<style>\n  $0\n</style>"
        },
        {
          "label": "vars",
          "detail": "CSS-Variablen aus Frontmatter",
          "body": "<style define:vars={{ ${farbe} }}>\n  ${div} { color: var(--${farbe}); }$0\n</style>"
        }
      ],
      "run": [
        {
          "label": "astro dev",
          "command": "npx",
          "args": [
            "astro",
            "dev"
          ]
        },
        {
          "label": "astro build",
          "command": "npx",
          "args": [
            "astro",
            "build"
          ]
        },
        {
          "label": "astro check",
          "command": "npx",
          "args": [
            "astro",
            "check"
          ]
        }
      ],
      "lsp": [
        {
          "label": "astro-ls",
          "command": "astro-ls",
          "args": [
            "--stdio"
          ],
          "languageId": "astro",
          "rootMarkers": [
            "astro.config.mjs",
            "astro.config.ts",
            "package.json",
            ".git"
          ],
          "initializationOptions": {
            "typescript": {
              "tsdk": "node_modules/typescript/lib"
            }
          },
          "install": "npm i -g @astrojs/language-server",
          "package": {
            "type": "npm",
            "packages": [
              "@astrojs/language-server",
              "typescript@6"
            ]
          }
        }
      ],
      "tokenizer": "markup-astro"
    }
  ],
  "themes": [],
  "commands": [],
  "events": [],
  "templates": [
    {
      "id": "astro-site",
      "name": "templates.web.astroName",
      "description": "templates.web.astroDescription",
      "languageId": "astro",
      "kindId": "npm",
      "icon": "As",
      "color": "#ff5d01",
      "fields": [
        {
          "id": "version",
          "label": "templates.fields.version",
          "default": "0.1.0",
          "pattern": "\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?",
          "patternHint": "templates.fields.versionHint",
          "section": "templates.sections.project",
          "mono": true
        },
        {
          "id": "description",
          "label": "templates.fields.description",
          "placeholder": "templates.fields.descriptionPlaceholder",
          "required": false,
          "section": "templates.sections.project"
        },
        {
          "id": "author",
          "label": "templates.fields.author",
          "placeholder": "templates.fields.authorPlaceholder",
          "required": false,
          "section": "templates.sections.project"
        },
        {
          "id": "license",
          "label": "templates.fields.license",
          "type": "select",
          "choices": [
            {
              "value": "MIT",
              "label": "MIT"
            },
            {
              "value": "Apache-2.0",
              "label": "Apache 2.0"
            },
            {
              "value": "GPL-3.0-or-later",
              "label": "GPL 3.0"
            },
            {
              "value": "BSD-3-Clause",
              "label": "BSD 3-Clause"
            },
            {
              "value": "UNLICENSED",
              "label": "templates.fields.licenseNone"
            }
          ],
          "section": "templates.sections.project"
        },
        {
          "id": "pm",
          "label": "templates.fields.packageManager",
          "type": "select",
          "choices": [
            {
              "value": "npm",
              "label": "npm"
            },
            {
              "value": "pnpm",
              "label": "pnpm"
            },
            {
              "value": "yarn",
              "label": "Yarn"
            },
            {
              "value": "bun",
              "label": "Bun"
            }
          ],
          "section": "templates.sections.build"
        },
        {
          "id": "mdx",
          "label": "templates.web.mdxIntegration",
          "type": "toggle",
          "default": "false",
          "section": "templates.sections.options"
        },
        {
          "id": "sitemap",
          "label": "Sitemap",
          "type": "toggle",
          "default": "false",
          "section": "templates.sections.options"
        }
      ],
      "open": "src/pages/index.astro",
      "next": "templates.node.nextDev",
      "setup": [
        {
          "label": "templates.tasks.installDeps",
          "command": "{{pm}}",
          "args": [
            "install"
          ]
        }
      ],
      "files": [
        {
          "path": "package.json",
          "when": [
            {
              "field": "mdx",
              "equals": "true"
            },
            {
              "field": "sitemap",
              "equals": "true"
            }
          ],
          "content": "{\n  \"version\": \"{{version}}\",\n  \"description\": \"{{description}}\",\n  \"author\": \"{{author}}\",\n  \"license\": \"{{license}}\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"astro dev\",\n    \"build\": \"astro build\",\n    \"preview\": \"astro preview\",\n    \"check\": \"astro check\"\n  },\n  \"dependencies\": {\n    \"astro\": \"^5.1.0\",\n    \"@astrojs/mdx\": \"^4.0.3\",\n    \"@astrojs/sitemap\": \"^3.2.1\"\n  }\n}\n"
        },
        {
          "path": "package.json",
          "when": [
            {
              "field": "mdx",
              "equals": "true"
            },
            {
              "field": "sitemap",
              "notEquals": "true"
            }
          ],
          "content": "{\n  \"version\": \"{{version}}\",\n  \"description\": \"{{description}}\",\n  \"author\": \"{{author}}\",\n  \"license\": \"{{license}}\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"astro dev\",\n    \"build\": \"astro build\",\n    \"preview\": \"astro preview\",\n    \"check\": \"astro check\"\n  },\n  \"dependencies\": {\n    \"astro\": \"^5.1.0\",\n    \"@astrojs/mdx\": \"^4.0.3\"\n  }\n}\n"
        },
        {
          "path": "package.json",
          "when": [
            {
              "field": "mdx",
              "notEquals": "true"
            },
            {
              "field": "sitemap",
              "equals": "true"
            }
          ],
          "content": "{\n  \"version\": \"{{version}}\",\n  \"description\": \"{{description}}\",\n  \"author\": \"{{author}}\",\n  \"license\": \"{{license}}\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"astro dev\",\n    \"build\": \"astro build\",\n    \"preview\": \"astro preview\",\n    \"check\": \"astro check\"\n  },\n  \"dependencies\": {\n    \"astro\": \"^5.1.0\",\n    \"@astrojs/sitemap\": \"^3.2.1\"\n  }\n}\n"
        },
        {
          "path": "package.json",
          "when": [
            {
              "field": "mdx",
              "notEquals": "true"
            },
            {
              "field": "sitemap",
              "notEquals": "true"
            }
          ],
          "content": "{\n  \"version\": \"{{version}}\",\n  \"description\": \"{{description}}\",\n  \"author\": \"{{author}}\",\n  \"license\": \"{{license}}\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"astro dev\",\n    \"build\": \"astro build\",\n    \"preview\": \"astro preview\",\n    \"check\": \"astro check\"\n  },\n  \"dependencies\": {\n    \"astro\": \"^5.1.0\"\n  }\n}\n"
        },
        {
          "path": "astro.config.mjs",
          "when": [
            {
              "field": "mdx",
              "equals": "true"
            },
            {
              "field": "sitemap",
              "equals": "true"
            }
          ],
          "content": "import { defineConfig } from 'astro/config'\nimport mdx from '@astrojs/mdx'\nimport sitemap from '@astrojs/sitemap'\n\nexport default defineConfig({\n  site: 'https://example.com',\n  integrations: [mdx(), sitemap()],\n})\n"
        },
        {
          "path": "astro.config.mjs",
          "when": [
            {
              "field": "mdx",
              "equals": "true"
            },
            {
              "field": "sitemap",
              "notEquals": "true"
            }
          ],
          "content": "import { defineConfig } from 'astro/config'\nimport mdx from '@astrojs/mdx'\n\nexport default defineConfig({\n  integrations: [mdx()],\n})\n"
        },
        {
          "path": "astro.config.mjs",
          "when": [
            {
              "field": "mdx",
              "notEquals": "true"
            },
            {
              "field": "sitemap",
              "equals": "true"
            }
          ],
          "content": "import { defineConfig } from 'astro/config'\nimport sitemap from '@astrojs/sitemap'\n\nexport default defineConfig({\n  site: 'https://example.com',\n  integrations: [sitemap()],\n})\n"
        },
        {
          "path": "astro.config.mjs",
          "when": [
            {
              "field": "mdx",
              "notEquals": "true"
            },
            {
              "field": "sitemap",
              "notEquals": "true"
            }
          ],
          "content": "import { defineConfig } from 'astro/config'\n\nexport default defineConfig({\n  integrations: [],\n})\n"
        },
        {
          "path": "tsconfig.json",
          "content": "{\n  \"extends\": \"astro/tsconfigs/strict\",\n  \"include\": [\n    \".astro/types.d.ts\",\n    \"**/*\"\n  ],\n  \"exclude\": [\n    \"dist\"\n  ]\n}\n"
        },
        {
          "path": "src/layouts/Layout.astro",
          "content": "---\ninterface Props {\n  title: string\n}\nconst { title } = Astro.props\n---\n\n<!doctype html>\n<html lang=\"de\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width\" />\n    <title>{title} · {{name}}</title>\n  </head>\n  <body>\n    <slot />\n  </body>\n</html>\n"
        },
        {
          "path": "src/components/Card.astro",
          "content": "---\ninterface Props {\n  title: string\n  href: string\n}\nconst { title, href } = Astro.props\n---\n\n<a class=\"card\" href={href}>{title}</a>\n\n<style>\n  .card {\n    display: block;\n    padding: 1rem;\n    border-radius: 0.5rem;\n  }\n</style>\n"
        },
        {
          "path": "src/pages/index.astro",
          "content": "---\nimport Layout from '../layouts/Layout.astro'\nimport Card from '../components/Card.astro'\n---\n\n<Layout title=\"Start\">\n  <main>\n    <h1>{{name}}</h1>\n    <Card title=\"Astro-Doku\" href=\"https://docs.astro.build\" />\n  </main>\n</Layout>\n"
        },
        {
          "path": "public/.gitkeep",
          "content": ""
        },
        {
          "path": ".gitignore",
          "content": "node_modules/\ndist/\n.env\n*.log\n.astro/\n.angular/\n.lumen/\n"
        },
        {
          "path": "README.md",
          "content": "# {{name}}\n\n{{description}}\n\n```bash\n{{pm}} install\n{{pm}} run dev\n{{pm}} run build\n```\n"
        },
        {
          "path": "src/pages/beispiel.mdx",
          "when": {
            "field": "mdx",
            "equals": "true"
          },
          "content": "---\nlayout: ../layouts/Layout.astro\ntitle: Beispiel\n---\n\n# MDX in {{name}}\n\nMarkdown mit **Komponenten**.\n"
        }
      ]
    }
  ],
  "projectKinds": [],
  "snippets": []
}
