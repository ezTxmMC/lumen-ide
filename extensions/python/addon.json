{
  "languages": [
    {
      "id": "python",
      "name": "Python",
      "extensions": [
        ".py",
        ".pyw",
        ".pyi"
      ],
      "icon": "Py",
      "color": "#3572a5",
      "capitalizedAsType": true,
      "comments": {
        "line": "#"
      },
      "controls": [
        "if",
        "elif",
        "else",
        "for",
        "while",
        "break",
        "continue",
        "return",
        "try",
        "except",
        "finally",
        "raise",
        "with",
        "yield",
        "await",
        "match",
        "case",
        "assert",
        "pass"
      ],
      "keywords": [
        "def",
        "class",
        "lambda",
        "import",
        "from",
        "as",
        "global",
        "nonlocal",
        "del",
        "in",
        "is",
        "not",
        "and",
        "or",
        "async",
        "await"
      ],
      "types": [
        "int",
        "float",
        "str",
        "bool",
        "bytes",
        "list",
        "dict",
        "set",
        "tuple",
        "frozenset",
        "complex",
        "object",
        "type",
        "Any",
        "Optional",
        "Union",
        "List",
        "Dict",
        "Set",
        "Tuple",
        "Callable",
        "Iterator",
        "Iterable"
      ],
      "builtins": [
        "print",
        "len",
        "range",
        "enumerate",
        "zip",
        "map",
        "filter",
        "sorted",
        "sum",
        "min",
        "max",
        "abs",
        "round",
        "open",
        "input",
        "isinstance",
        "issubclass",
        "getattr",
        "setattr",
        "hasattr",
        "super",
        "repr",
        "format",
        "any",
        "all",
        "reversed",
        "iter",
        "next",
        "id",
        "hash",
        "vars",
        "dir"
      ],
      "constants": [
        "True",
        "False",
        "None",
        "NotImplemented",
        "Ellipsis",
        "self",
        "cls"
      ],
      "strings": [
        {
          "start": "\"\"\"",
          "end": "\"\"\"",
          "multiline": true,
          "escapes": false
        },
        {
          "start": "'''",
          "end": "'''",
          "multiline": true,
          "escapes": false
        },
        {
          "start": "\"",
          "escapes": true
        },
        {
          "start": "'",
          "escapes": true
        }
      ],
      "meta": "^@[A-Za-z_]\\w*",
      "indentOpen": ":\\s*(?:#.*)?$",
      "indentClose": "^\\s*(?:else|elif|except|finally|case)\\b",
      "indentUnit": 4,
      "snippets": [
        {
          "label": "def",
          "detail": "Funktion",
          "body": "def ${name}(${args}):\n    $0"
        },
        {
          "label": "class",
          "detail": "Klasse",
          "body": "class ${Name}:\n    def __init__(self):\n        $0"
        },
        {
          "label": "main",
          "detail": "Einstiegspunkt",
          "body": "def main():\n    $0\n\n\nif __name__ == \"__main__\":\n    main()"
        },
        {
          "label": "with",
          "detail": "Kontextmanager",
          "body": "with open(${\"datei.txt\"}) as f:\n    $0"
        },
        {
          "label": "dc",
          "detail": "Dataclass",
          "body": "from dataclasses import dataclass\n\n\n@dataclass(slots=True)\nclass ${Name}:\n    ${feld}: ${str}$0"
        },
        {
          "label": "try",
          "detail": "try/except",
          "body": "try:\n    $0\nexcept ${Exception} as err:\n    raise RuntimeError(${\"fehlgeschlagen\"}) from err"
        },
        {
          "label": "forr",
          "detail": "for-Schleife",
          "body": "for ${element} in ${liste}:\n    $0"
        },
        {
          "label": "enum",
          "detail": "Enum",
          "body": "from enum import Enum\n\n\nclass ${Name}(Enum):\n    ${EINS} = ${\"eins\"}$0"
        },
        {
          "label": "comp",
          "detail": "List Comprehension",
          "body": "[${x} for ${x} in ${liste} if $0]"
        },
        {
          "label": "dictc",
          "detail": "Dict Comprehension",
          "body": "{${k}: ${v} for ${k}, ${v} in ${quelle}.items()}$0"
        },
        {
          "label": "async",
          "detail": "async def",
          "body": "async def ${name}(${args}) -> ${None}:\n    $0"
        },
        {
          "label": "agather",
          "detail": "asyncio.gather",
          "body": "results = await asyncio.gather(*[${aufgabe}(x) for x in ${liste}])$0"
        },
        {
          "label": "type",
          "detail": "Typalias",
          "body": "type ${Name} = ${dict}[${str}, ${int}]$0"
        },
        {
          "label": "match",
          "detail": "match",
          "body": "match ${wert}:\n    case ${muster}:\n        $0\n    case _:\n        pass"
        },
        {
          "label": "test",
          "detail": "pytest-Test",
          "body": "def test_${verhalten}():\n    assert $0"
        },
        {
          "label": "arg",
          "detail": "argparse",
          "body": "import argparse\n\nparser = argparse.ArgumentParser(description=\"${Beschreibung}\")\nparser.add_argument(\"${name}\")\nargs = parser.parse_args()$0"
        },
        {
          "label": "prop",
          "detail": "Property",
          "body": "@property\ndef ${name}(self) -> ${str}:\n    return self._${name}$0"
        }
      ],
      "run": [
        {
          "label": "python3",
          "command": "python3",
          "args": [
            "${file}"
          ]
        },
        {
          "label": "python",
          "command": "python",
          "args": [
            "${file}"
          ]
        },
        {
          "label": "uv run",
          "command": "uv",
          "args": [
            "run",
            "${file}"
          ]
        },
        {
          "label": "pytest",
          "command": "pytest",
          "args": [
            "-q"
          ]
        }
      ],
      "lsp": [
        {
          "label": "pyright",
          "command": "pyright-langserver",
          "args": [
            "--stdio"
          ],
          "languageId": "python",
          "rootMarkers": [
            "pyproject.toml",
            "setup.py",
            "requirements.txt",
            ".git"
          ],
          "settings": {
            "python": {
              "analysis": {
                "typeCheckingMode": "basic",
                "autoImportCompletions": true,
                "autoSearchPaths": true,
                "useLibraryCodeForTypes": true,
                "indexing": true,
                "packageIndexDepths": [
                  {
                    "name": "",
                    "depth": 10,
                    "includeAllSymbols": true
                  }
                ]
              }
            }
          },
          "install": "npm i -g pyright",
          "package": {
            "type": "npm",
            "packages": [
              "pyright"
            ]
          }
        },
        {
          "label": "basedpyright",
          "command": "basedpyright-langserver",
          "args": [
            "--stdio"
          ],
          "languageId": "python",
          "rootMarkers": [
            "pyproject.toml",
            ".git"
          ],
          "settings": {
            "basedpyright": {
              "analysis": {
                "typeCheckingMode": "standard",
                "autoImportCompletions": true,
                "autoSearchPaths": true,
                "useLibraryCodeForTypes": true,
                "indexing": true,
                "packageIndexDepths": [
                  {
                    "name": "",
                    "depth": 10,
                    "includeAllSymbols": true
                  }
                ]
              }
            }
          },
          "install": "pip install basedpyright",
          "package": {
            "type": "pypi",
            "package": "basedpyright"
          }
        },
        {
          "label": "ruff server",
          "command": "ruff",
          "args": [
            "server"
          ],
          "languageId": "python",
          "rootMarkers": [
            "pyproject.toml",
            "ruff.toml",
            ".git"
          ],
          "install": "pip install ruff",
          "package": {
            "type": "pypi",
            "package": "ruff"
          }
        },
        {
          "label": "python-lsp-server",
          "command": "pylsp",
          "args": [],
          "languageId": "python",
          "install": "pip install python-lsp-server",
          "package": {
            "type": "pypi",
            "package": "python-lsp-server"
          }
        }
      ],
      "debug": [
        "debugpy"
      ]
    }
  ],
  "themes": [],
  "commands": [],
  "events": [],
  "templates": [],
  "projectKinds": [],
  "snippets": []
}
