{
  "id": "ext.example",
  "name": "Example",
  "version": "1.0.1",
  "description": "Shows what an extension can ship: a language, settings and pages.",
  "author": "Lumen",
  "icon": "Bs",
  "color": "#4f5bd5",
  "category": "tool",
  "license": "MIT",
  "keywords": ["example", "template", "documentation"],
  "minAppVersion": "0.5.0",
  "settings": [
    {
      "key": "greeting",
      "label": "Greeting",
      "type": "text",
      "default": "Hello",
      "placeholder": "Hello",
      "hint": "Appears in the settings under “Extensions”."
    },
    {
      "key": "verbose",
      "label": "Verbose output",
      "type": "toggle",
      "default": "false"
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "default": "balanced",
      "choices": [
        { "value": "fast", "label": "Fast" },
        { "value": "balanced", "label": "Balanced" },
        { "value": "thorough", "label": "Thorough" }
      ]
    }
  ]
}
