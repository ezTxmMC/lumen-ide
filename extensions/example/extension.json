{
  "id": "ext.example",
  "name": "Beispiel",
  "version": "1.0.1",
  "description": "Zeigt, was eine Erweiterung mitbringen kann: Sprache, Einstellungen und Seiten.",
  "author": "Lumen",
  "icon": "Bs",
  "color": "#4f5bd5",
  "category": "tool",
  "license": "MIT",
  "keywords": ["beispiel", "vorlage", "dokumentation"],
  "minAppVersion": "0.5.0",
  "settings": [
    {
      "key": "greeting",
      "label": "Begrüßung",
      "type": "text",
      "default": "Hallo",
      "placeholder": "Hallo",
      "hint": "Steht in den Einstellungen unter „Erweiterungen“."
    },
    {
      "key": "verbose",
      "label": "Ausführliche Ausgabe",
      "type": "toggle",
      "default": "false"
    },
    {
      "key": "mode",
      "label": "Betriebsart",
      "type": "select",
      "default": "balanced",
      "choices": [
        { "value": "fast", "label": "Schnell" },
        { "value": "balanced", "label": "Ausgewogen" },
        { "value": "thorough", "label": "Gründlich" }
      ]
    }
  ]
}
