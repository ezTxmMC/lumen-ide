{
  "languages": [],
  "themes": [],
  "commands": [],
  "events": [],
  "snippets": [],
  "projectKinds": [
    {
      "id": "codex",
      "name": "ChatGPT Codex",
      "icon": "Cx",
      "color": "#10a37f",
      "markers": [
        "AGENTS.md",
        ".codex"
      ],
      "priority": 1,
      "buildFile": "AGENTS.md",
      "tasks": [
        {
          "id": "session",
          "label": "Codex starten",
          "command": "codex",
          "args": [],
          "group": "run",
          "detail": "Neue Sitzung im Projektordner"
        },
        {
          "id": "resume",
          "label": "Letzte Sitzung fortsetzen",
          "command": "codex",
          "args": [
            "resume",
            "--last"
          ],
          "group": "run"
        },
        {
          "id": "login",
          "label": "Anmelden",
          "command": "codex",
          "args": [
            "login"
          ],
          "group": "other",
          "detail": "Mit ChatGPT-Konto oder API-Schlüssel"
        },
        {
          "id": "mcp",
          "label": "MCP-Server anzeigen",
          "command": "codex",
          "args": [
            "mcp",
            "list"
          ],
          "group": "other"
        },
        {
          "id": "install",
          "label": "Codex installieren",
          "command": "npm",
          "args": [
            "install",
            "-g",
            "@openai/codex"
          ],
          "group": "build",
          "detail": "Benötigt Node.js"
        }
      ],
      "facts": [
        {
          "label": "Anweisungen",
          "file": "AGENTS.md",
          "pattern": "^#\\s+(.+)$"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "codex-project",
      "name": "Codex Projekt",
      "description": "AGENTS.md mit Befehlen und Konventionen für Codex.",
      "kindId": "codex",
      "icon": "Cx",
      "color": "#10a37f",
      "open": "AGENTS.md",
      "next": "Starte Codex über die Aufgabenliste.",
      "fields": [
        {
          "id": "description",
          "label": "Beschreibung",
          "section": "Projekt",
          "placeholder": "Was macht das Projekt?",
          "required": false
        },
        {
          "id": "commands",
          "label": "Bau- und Testbefehle",
          "section": "Projekt",
          "placeholder": "npm test",
          "required": false,
          "mono": true
        }
      ],
      "files": [
        {
          "path": "AGENTS.md",
          "content": "# {{name}}\n\n{{description}}\n\n## Befehle\n\n```sh\n{{commands}}\n```\n\n## Konventionen\n\n- Kleine, überprüfbare Änderungen\n- Tests vor dem Abschluss ausführen\n"
        }
      ]
    }
  ]
}
