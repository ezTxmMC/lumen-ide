{
  "languages": [],
  "themes": [],
  "commands": [],
  "events": [],
  "snippets": [],
  "projectKinds": [
    {
      "id": "codex",
      "name": "ChatGPT Codex",
      "icon": "Cx",
      "color": "#10a37f",
      "markers": [
        "AGENTS.md",
        ".codex"
      ],
      "priority": 1,
      "buildFile": "AGENTS.md",
      "tasks": [
        {
          "id": "session",
          "label": "Start Codex",
          "command": "codex",
          "args": [],
          "group": "run",
          "detail": "New session in the project folder"
        },
        {
          "id": "resume",
          "label": "Resume last session",
          "command": "codex",
          "args": [
            "resume",
            "--last"
          ],
          "group": "run"
        },
        {
          "id": "login",
          "label": "Sign in",
          "command": "codex",
          "args": [
            "login"
          ],
          "group": "other",
          "detail": "With a ChatGPT account or API key"
        },
        {
          "id": "mcp",
          "label": "Show MCP servers",
          "command": "codex",
          "args": [
            "mcp",
            "list"
          ],
          "group": "other"
        },
        {
          "id": "install",
          "label": "Install Codex",
          "command": "npm",
          "args": [
            "install",
            "-g",
            "@openai/codex"
          ],
          "group": "build",
          "detail": "Requires Node.js"
        }
      ],
      "facts": [
        {
          "label": "Instructions",
          "file": "AGENTS.md",
          "pattern": "^#\\s+(.+)$"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "codex-project",
      "name": "Codex Projekt",
      "description": "AGENTS.md with commands and conventions for Codex.",
      "kindId": "codex",
      "icon": "Cx",
      "color": "#10a37f",
      "open": "AGENTS.md",
      "next": "Start Codex from the task list.",
      "fields": [
        {
          "id": "description",
          "label": "Description",
          "section": "Projekt",
          "placeholder": "What does the project do?",
          "required": false
        },
        {
          "id": "commands",
          "label": "Build and test commands",
          "section": "Projekt",
          "placeholder": "npm test",
          "required": false,
          "mono": true
        }
      ],
      "files": [
        {
          "path": "AGENTS.md",
          "content": "# {{name}}\n\n{{description}}\n\n## Commands\n\n```sh\n{{commands}}\n```\n\n## Conventions\n\n- Small, reviewable changes\n- Run the tests before finishing\n"
        }
      ]
    }
  ]
}
