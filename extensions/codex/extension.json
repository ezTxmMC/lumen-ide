{
  "id": "ext.codex",
  "name": "ChatGPT Codex",
  "version": "2.1.1",
  "description": "OpenAI Codex as a chat agent: models from the Codex CLI or its model cache, reasoning effort per model, sandbox modes, web search, resumable sessions, images and plan. Plus tasks and an AGENTS.md template. Ships executable code.",
  "author": "Lumen",
  "icon": "Cx",
  "color": "#10a37f",
  "category": "tool",
  "license": "MIT",
  "keywords": [
    "codex",
    "chatgpt",
    "openai",
    "ai",
    "agent",
    "cli"
  ],
  "minAppVersion": "0.5.2",
  "settings": [
    {
      "key": "codexPath",
      "label": "Path to codex",
      "type": "path",
      "pathKind": "file",
      "section": "Program",
      "default": "",
      "placeholder": "search automatically",
      "hint": "Leave empty to find codex on the PATH and in the usual folders."
    },
    {
      "key": "profile",
      "label": "Profile from config.toml",
      "type": "text",
      "section": "Program",
      "default": "",
      "placeholder": "none",
      "hint": "A profile from ~/.codex/config.toml that applies to every message."
    },
    {
      "key": "model",
      "label": "Default model",
      "type": "text",
      "section": "Model",
      "default": "",
      "placeholder": "as in config.toml",
      "hint": "Applies while \"Default\" is chosen in the chat — e.g. gpt-5-codex. The chat picker comes from Codex itself."
    },
    {
      "key": "modelSource",
      "label": "Model list from",
      "type": "select",
      "section": "Model",
      "default": "auto",
      "hint": "\"Automatic\" reads ~/.codex/models_cache.json and asks codex app-server when the file is missing or you reload.",
      "choices": [
        {
          "value": "auto",
          "label": "Automatic (cache, else CLI)"
        },
        {
          "value": "cache",
          "label": "models_cache.json only"
        },
        {
          "value": "cli",
          "label": "Always codex app-server"
        }
      ]
    },
    {
      "key": "showLegacyModels",
      "label": "Offer older and hidden models",
      "type": "toggle",
      "section": "Model",
      "default": "false",
      "hint": "Also adds models that Codex hides in its own list."
    },
    {
      "key": "modelCacheMinutes",
      "label": "CLI-Cache model list (minutes)",
      "type": "number",
      "section": "Model",
      "default": "60",
      "min": 0,
      "max": 10080,
      "when": "modelSource=cli"
    },
    {
      "key": "extraModels",
      "label": "More models",
      "type": "textarea",
      "section": "Model",
      "rows": 2,
      "default": "",
      "placeholder": "gpt-5-codex | GPT-5 Codex (pinned)",
      "hint": "In addition to the Codex list — one model ID per line, optionally with \"| Display name\"."
    },
    {
      "key": "reasoningEffort",
      "label": "Default reasoning effort",
      "type": "select",
      "section": "Model",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "As in config.toml"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "low",
          "label": "Low"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "high",
          "label": "High"
        },
        {
          "value": "xhigh",
          "label": "Very high"
        }
      ],
      "hint": "Applies while no effort is chosen in the chat. In the chat it can be set per model — only the levels the model supports are offered."
    },
    {
      "key": "reasoningSummary",
      "label": "Reasoning summary",
      "type": "select",
      "section": "Model",
      "default": "default",
      "choices": [
        {
          "value": "default",
          "label": "As in config.toml"
        },
        {
          "value": "auto",
          "label": "Automatic"
        },
        {
          "value": "concise",
          "label": "Concise"
        },
        {
          "value": "detailed",
          "label": "Detailed"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "key": "verbosity",
      "label": "Answer verbosity",
      "type": "select",
      "section": "Model",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "As in config.toml"
        },
        {
          "value": "low",
          "label": "Concise"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "high",
          "label": "Detailed"
        }
      ]
    },
    {
      "key": "hideReasoning",
      "label": "Hide reasoning",
      "type": "toggle",
      "section": "Model",
      "default": "false"
    },
    {
      "key": "webSearch",
      "label": "Web search",
      "type": "select",
      "section": "Tools",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "As in config.toml"
        },
        {
          "value": "live",
          "label": "Live"
        },
        {
          "value": "cached",
          "label": "From the cache"
        },
        {
          "value": "disabled",
          "label": "Off"
        }
      ]
    },
    {
      "key": "networkAccess",
      "label": "Network in \"In project\" sandbox mode",
      "type": "select",
      "section": "Tools",
      "default": "auto",
      "hint": "Whether commands in the \"In project\" mode may access the network (npm install, curl …).",
      "choices": [
        {
          "value": "auto",
          "label": "As in config.toml"
        },
        {
          "value": "true",
          "label": "Allowed"
        },
        {
          "value": "false",
          "label": "Blocked"
        }
      ]
    },
    {
      "key": "approvalPolicy",
      "label": "Approval policy",
      "type": "select",
      "section": "Permissions",
      "default": "never",
      "hint": "Codex cannot ask questions in the chat — what it may do is set by the sandbox mode. \"Never ask\" keeps Codex from waiting for an answer.",
      "choices": [
        {
          "value": "never",
          "label": "Never ask"
        },
        {
          "value": "on-failure",
          "label": "On failure"
        },
        {
          "value": "on-request",
          "label": "On the model's request"
        },
        {
          "value": "untrusted",
          "label": "For untrusted commands"
        },
        {
          "value": "auto",
          "label": "As in config.toml"
        }
      ]
    },
    {
      "key": "allowFullAccess",
      "label": "Allow \"Full access\" mode",
      "type": "toggle",
      "section": "Permissions",
      "default": "false",
      "hint": "Warning: without a sandbox Codex can change any file and run any command. Use only in isolated environments."
    },
    {
      "key": "additionalDirectories",
      "label": "More writable folders",
      "type": "textarea",
      "section": "Permissions",
      "rows": 2,
      "default": "",
      "placeholder": "~/shared-lib",
      "hint": "One per line."
    },
    {
      "key": "skipGitRepoCheck",
      "label": "Also work outside Git repositories",
      "type": "toggle",
      "section": "Permissions",
      "default": "true"
    },
    {
      "key": "configOverrides",
      "label": "More configuration (-c)",
      "type": "textarea",
      "section": "Advanced",
      "rows": 3,
      "default": "",
      "placeholder": "model_verbosity=\"low\"\nhide_agent_reasoning=true",
      "hint": "One key=value per line in TOML format, as with `codex -c`."
    },
    {
      "key": "env",
      "label": "Environment variables",
      "type": "textarea",
      "section": "Advanced",
      "rows": 3,
      "default": "",
      "placeholder": "OPENAI_API_KEY=…\nHTTPS_PROXY=http://proxy:3128",
      "hint": "KEY=VALUE, one per line."
    }
  ],
  "agents": [
    {
      "id": "codex",
      "name": "Codex",
      "description": "Ask Codex about your project: explain code, find bugs, make changes. What Codex may do is set by the mode.",
      "icon": "Cx",
      "location": "right",
      "images": true,
      "placeholder": "Message Codex …  (Enter to send, Shift+Enter for a new line, @ files)",
      "modelSetting": "model",
      "models": [],
      "modes": [
        {
          "id": "workspace-write",
          "label": "In project",
          "description": "Reads everything, changes and runs only in the project folder"
        },
        {
          "id": "read-only",
          "label": "Read only",
          "description": "Reads and plans, changes nothing"
        },
        {
          "id": "danger-full-access",
          "label": "Full access",
          "description": "No sandbox — must be enabled in the settings"
        }
      ],
      "suggestions": [
        "Explain the structure of this project.",
        "Find possible bugs in the open file.",
        "Write tests for the current selection.",
        "Create an AGENTS.md for this project."
      ]
    }
  ]
}
