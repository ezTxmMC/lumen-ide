        {
          "label": "comp",
          "detail": "Standalone-Komponente",
          "body": "import { Component, ChangeDetectionStrategy, signal } from '@angular/core'\n\n@Component({\n  selector: '${app-name}',\n  standalone: true,\n  imports: [],\n  template: `\n    <h1>{{ ${titel}() }}</h1>\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class ${Name}Component {\n  readonly ${titel} = signal('${Hallo}')$0\n}"
        },
        {
          "label": "service",
          "detail": "Service",
          "body": "import { Injectable, inject } from '@angular/core'\n\n@Injectable({ providedIn: 'root' })\nexport class ${Name}Service {\n  $0\n}"
        },
        {
          "label": "sig",
          "detail": "Signal",
          "body": "readonly ${wert} = signal(${0})$0"
        },
        {
          "label": "comp$",
          "detail": "computed",
          "body": "readonly ${abgeleitet} = computed(() => $0)"
        },
        {
          "label": "eff",
          "detail": "effect",
          "body": "effect(() => {\n  $0\n})"
        },
        {
          "label": "in",
          "detail": "Signal-Input",
          "body": "readonly ${wert} = input.required<${string}>()$0"
        },
        {
          "label": "out",
          "detail": "Signal-Output",
          "body": "readonly ${geändert} = output<${string}>()$0"
        },
        {
          "label": "inj",
          "detail": "inject",
          "body": "private readonly ${dienst} = inject(${Dienst})$0"
        },
        {
          "label": "pipe",
          "detail": "Pipe",
          "body": "import { Pipe, PipeTransform } from '@angular/core'\n\n@Pipe({ name: '${name}', standalone: true })\nexport class ${Name}Pipe implements PipeTransform {\n  transform(${wert}: ${string}): ${string} {\n    return $0\n  }\n}"
        }
