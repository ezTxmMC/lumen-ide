          "detail": "Export",
          "body": "export const ${name} = $0"
        },
        {
          "label": "forof",
          "detail": "for…of",
          "body": "for (const ${element} of ${liste}) {\n  $0\n}"
        },
        {
          "label": "fore",
          "detail": "forEach",
          "body": "${liste}.forEach((${element}) => {\n  $0\n})"
        },
        {
          "label": "map",
          "detail": "map",
          "body": "${liste}.map((${element}) => $0)"
        },
        {
          "label": "filter",
          "detail": "filter",
          "body": "${liste}.filter((${element}) => $0)"
        },
        {
          "label": "reduce",
          "detail": "reduce",
          "body": "${liste}.reduce((${acc}, ${element}) => $0, ${start})"
