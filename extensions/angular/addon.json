{
  "languages": [
    {
      "id": "angular-html",
      "name": "Angular-Template",
      "extensions": [
        ".component.html",
        ".template.html"
      ],
      "icon": "A",
      "color": "#dd0031",
      "priority": 20,
      "comments": {
        "block": [
          "<!--",
          "-->"
        ]
      },
      "indentOpen": "<(?!\\/|.*\\/>)[^>]*>\\s*$|\\{\\s*$",
      "indentClose": "^\\s*(?:<\\/|\\}|@\\})",
      "completions": [
        "*ngIf",
        "*ngFor",
        "*ngSwitchCase",
        "*ngSwitchDefault",
        "ngClass",
        "ngStyle",
        "ngModel",
        "ngSubmit",
        "ngTemplateOutlet",
        "ngContainer",
        "ng-content",
        "@if",
        "@else",
        "@for",
        "@empty",
        "@switch",
        "@case",
        "@default",
        "@defer",
        "@placeholder",
        "@loading",
        "@error",
        "@let",
        "(click)",
        "(input)",
        "(change)",
        "(submit)",
        "(keyup.enter)",
        "(blur)",
        "[class]",
        "[style]",
        "[disabled]",
        "[value]",
        "[ngModel]",
        "[(ngModel)]",
        "trackBy",
        "async",
        "json",
        "date",
        "currency",
        "uppercase",
        "lowercase"
      ],
      "snippets": [
        {
          "label": "if",
          "detail": "Kontrollfluss @if",
          "body": "@if (${bedingung}) {\n  $0\n} @else {\n}"
        },
        {
          "label": "for",
          "detail": "Kontrollfluss @for",
          "body": "@for (${element} of ${liste}; track ${element}.id) {\n  $0\n} @empty {\n}"
        },
        {
          "label": "switch",
          "detail": "Kontrollfluss @switch",
          "body": "@switch (${wert}) {\n  @case (${a}) { $0 }\n  @default { }\n}"
        },
        {
          "label": "defer",
          "detail": "Verzögertes Laden",
          "body": "@defer (on viewport) {\n  <${komponente} />$0\n} @placeholder {\n  <div>Lädt…</div>\n}"
        },
        {
          "label": "ngif",
          "detail": "*ngIf (klassisch)",
          "body": "<div *ngIf=\"${bedingung}; else ${sonst}\">$0</div>\n<ng-template #${sonst}></ng-template>"
        },
        {
          "label": "ngfor",
          "detail": "*ngFor (klassisch)",
          "body": "<${li} *ngFor=\"let ${element} of ${liste}; trackBy: ${trackById}\">$0</${li}>"
        },
        {
          "label": "bind",
          "detail": "Zwei-Wege-Bindung",
          "body": "<input [(ngModel)]=\"${wert}\" name=\"${name}\" />$0"
        },
        {
          "label": "async",
          "detail": "async-Pipe",
          "body": "{{ ${quelle$} | async }}$0"
        }
      ],
      "lsp": [
        {
          "label": "Angular Language Service",
          "command": "ngserver",
          "args": [
            "--stdio",
            "--tsProbeLocations",
            ".",
            "--ngProbeLocations",
            "."
          ],
          "languageId": "html",
          "rootMarkers": [
            "angular.json",
            "nx.json",
            "package.json",
            ".git"
          ],
          "install": "npm i -g @angular/language-server typescript",
          "package": {
            "type": "npm",
            "packages": [
              "@angular/language-server",
              "typescript@6"
            ]
          }
        },
        {
          "label": "vscode-html-language-server",
          "command": "vscode-html-language-server",
          "args": [
            "--stdio"
          ],
          "languageId": "html",
          "install": "npm i -g vscode-langservers-extracted",
          "package": {
            "type": "npm",
            "packages": [
              "vscode-langservers-extracted"
            ]
          }
        }
      ],
      "tokenizer": "markup-mustache"
    },
