        {
          "label": "fetch",
          "detail": "fetch mit await",
          "body": "const res = await fetch('${url}')\nif (!res.ok) throw new Error(res.statusText)\nconst data = await res.json()$0"
        },
        {
          "label": "prom",
          "detail": "Promise",
          "body": "new Promise((resolve, reject) => {\n  $0\n})"
        },
        {
          "label": "timeout",
          "detail": "setTimeout",
          "body": "setTimeout(() => {\n  $0\n}, ${200})"
        },
        {
          "label": "switch",
          "detail": "switch",
          "body": "switch (${wert}) {\n  case ${1}:\n    $0\n    break\n  default:\n    break\n}"
        },
