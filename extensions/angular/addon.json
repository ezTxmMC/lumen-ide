          "label": "destr",
          "detail": "Destrukturierung",
          "body": "const { ${a}, ${b} } = ${objekt}$0"
        },
        {
          "label": "iface",
          "detail": "Interface",
          "body": "interface ${Name} {\n  $0\n}"
        },
        {
          "label": "tp",
          "detail": "Type-Alias",
          "body": "type ${Name} = $0"
        },
        {
          "label": "enum",
          "detail": "Enum",
          "body": "enum ${Name} {\n  ${A} = '${a}',\n  $0\n}"
