          "body": "const ${NAME} = [$0] as const"
        },
        {
          "label": "record",
          "detail": "Record-Typ",
          "body": "type ${Name} = Record<${string}, ${unknown}>"
        },
        {
          "label": "partial",
          "detail": "Optionaler Parameter",
          "body": "${name}?: ${string}"
        },
        {
          "label": "generic",
          "detail": "Generisches Interface",
          "body": "interface ${Name}<${T}> {\n  ${wert}: ${T}\n}"
