{
  "id": "ext.discord",
  "name": "Discord Rich Presence",
  "version": "1.0.1",
  "description": "Zeigt in Discord, woran du arbeitest: Datei, Projekt, Sprache und Dauer — mit Leerlauf, privaten Projekten und Repository-Knopf. Bringt Programmcode mit.",
  "author": "Lumen",
  "icon": "DC",
  "color": "#5865f2",
  "category": "tool",
  "license": "MIT",
  "keywords": [
    "discord",
    "rich presence",
    "presence",
    "status",
    "rpc"
  ],
  "minAppVersion": "0.5.0",
  "settings": [
    {
      "key": "clientId",
      "label": "Client-ID (Application ID)",
      "type": "text",
      "default": "1550197013260275863",
      "placeholder": "123456789012345678",
      "hint": "Die Anwendung, deren Name in Discord als „Spielt …“ erscheint. Eine eigene legst du unter discord.com/developers an; ihre Bilder heißen wie die Sprach-IDs (java, typescript …) plus lumen. Leer = keine Verbindung.",
      "section": "Verbindung",
      "i18n": {
        "en": {
          "label": "Client ID (Application ID)",
          "hint": "The application whose name appears in Discord as “Playing …”. Create your own at discord.com/developers; its art assets are named after the language IDs (java, typescript …) plus lumen. Empty = no connection.",
          "section": "Connection"
        },
        "es": {
          "label": "ID de cliente (Application ID)",
          "hint": "La aplicación cuyo nombre aparece en Discord como «Jugando a …». Crea la tuya en discord.com/developers; sus imágenes se llaman como los ID de lenguaje (java, typescript …) más lumen. Vacío = sin conexión.",
          "section": "Conexión"
        },
        "fr": {
          "label": "ID client (Application ID)",
          "hint": "L’application dont le nom apparaît dans Discord comme « Joue à … ». Créez la vôtre sur discord.com/developers ; ses images portent le nom des ID de langage (java, typescript …) plus lumen. Vide = aucune connexion.",
          "section": "Connexion"
        },
        "pl": {
          "label": "ID klienta (Application ID)",
          "hint": "Aplikacja, której nazwa pojawia się w Discordzie jako „Gra w …”. Własną utworzysz na discord.com/developers; jej obrazy nazywają się jak identyfikatory języków (java, typescript …) oraz lumen. Puste = brak połączenia.",
          "section": "Połączenie"
        },
        "it": {
          "label": "ID client (Application ID)",
          "hint": "L’applicazione il cui nome compare su Discord come “Sta giocando a …”. Creane una tua su discord.com/developers; le sue immagini si chiamano come gli ID dei linguaggi (java, typescript …) più lumen. Vuoto = nessuna connessione.",
          "section": "Connessione"
        },
        "pt": {
          "label": "ID do cliente (Application ID)",
          "hint": "A aplicação cujo nome aparece no Discord como “Jogando …”. Crie a sua em discord.com/developers; as imagens têm o nome dos IDs de linguagem (java, typescript …) mais lumen. Vazio = sem conexão.",
          "section": "Conexão"
        },
        "nl": {
          "label": "Client-ID (Application ID)",
          "hint": "De applicatie waarvan de naam in Discord verschijnt als „Speelt …”. Maak je eigen aan op discord.com/developers; de afbeeldingen heten zoals de taal-ID’s (java, typescript …) plus lumen. Leeg = geen verbinding.",
          "section": "Verbinding"
        }
      }
