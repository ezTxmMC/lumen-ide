{
  "name": "lumen-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "The extensions of Lumen IDE — built into manifests and published to an extension server. Runs on its own from this folder.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "ezTxmMC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node ../scripts/test-extensions.mjs",
    "publish": "node publish.mjs",
    "server": "node ../extension-server/src/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
