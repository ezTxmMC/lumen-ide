{
  "id": "ext.git",
  "name": "Git",
  "version": "1.1.1",
  "description": "Source control with Git: stage and commit changes, diffs, history, branches, tags, stashes, push/pull and the branch in the status bar. Ships with program code.",
  "author": "Lumen",
  "icon": "Gt",
  "color": "#f05033",
  "category": "tool",
  "license": "MIT",
  "keywords": [
    "git",
    "scm",
    "source control",
    "version control",
    "commit",
    "branch"
  ],
  "minAppVersion": "0.5.0",
  "settings": [
    {
      "key": "gitPath",
      "label": "Path to git",
      "type": "path",
      "pathKind": "file",
      "default": "",
      "placeholder": "git from PATH",
      "hint": "Leave empty to use git from PATH.",
      "section": "General"
    },
    {
      "key": "showUntracked",
      "label": "Show untracked files",
      "type": "toggle",
      "default": "true",
      "section": "General"
    },
    {
      "key": "historyLimit",
      "label": "Commits in history",
      "type": "number",
      "default": "200",
      "min": 20,
      "max": 2000,
      "step": 20,
      "section": "General"
    },
    {
      "key": "confirmDiscard",
      "label": "Ask before discarding",
      "type": "toggle",
      "default": "true",
      "section": "Commits"
    },
    {
      "key": "signOff",
      "label": "Sign off commits (--signoff)",
      "type": "toggle",
      "default": "false",
      "hint": "Appends a Signed-off-by line to every commit message.",
      "section": "Commits"
    },
    {
      "key": "pullMode",
      "label": "Pull behavior",
      "type": "select",
      "default": "merge",
      "section": "Sync",
      "choices": [
        {
          "value": "merge",
          "label": "Merge"
        },
        {
          "value": "rebase",
          "label": "Rebase"
        },
        {
          "value": "ff-only",
          "label": "Fast-forward only"
        }
      ]
    },
    {
      "key": "followTags",
      "label": "Push tags too (--follow-tags)",
      "type": "toggle",
      "default": "false",
      "section": "Sync"
    },
    {
      "key": "autoFetchMinutes",
      "label": "Fetch automatically (minutes)",
      "type": "number",
      "default": "0",
      "min": 0,
      "max": 240,
      "step": 1,
      "hint": "0 turns automatic fetch off.",
      "section": "Sync"
    }
  ],
  "views": [
    {
      "id": "changes",
      "title": "Source Control",
      "icon": "git-branch",
      "location": "left",
      "order": 15
    },
    {
      "id": "branches",
      "title": "Branches",
      "icon": "git-fork",
      "location": "left",
      "order": 16
    },
    {
      "id": "history",
      "title": "Git History",
      "icon": "history",
      "location": "bottom",
      "order": 70
    }
  ],
  "commands": [
    {
      "id": "git.refresh",
      "title": "Git: Refresh",
      "category": "Git",
      "icon": "refresh-cw"
    },
    {
      "id": "git.open-changes",
      "title": "Git: Show Source Control",
      "category": "Git",
      "icon": "git-branch",
      "keybinding": "Ctrl+Shift+G"
    },
    {
      "id": "git.open-history",
      "title": "Git: Show History",
      "category": "Git",
      "icon": "history"
    },
    {
      "id": "git.open-branches",
      "title": "Git: Show Branches",
      "category": "Git",
      "icon": "git-branch"
    },
    {
      "id": "git.commit",
      "title": "Git: Commit",
      "category": "Git",
      "icon": "git-commit"
    },
    {
      "id": "git.commit-amend",
      "title": "Git: Amend Last Commit",
      "category": "Git",
      "icon": "pencil"
    },
    {
      "id": "git.stage-all",
      "title": "Git: Stage All Changes",
      "category": "Git",
      "icon": "plus"
    },
    {
      "id": "git.unstage-all",
      "title": "Git: Unstage All Changes",
      "category": "Git",
      "icon": "minus"
    },
    {
      "id": "git.discard-all",
      "title": "Git: Discard All Changes",
      "category": "Git",
      "icon": "undo"
    },
    {
      "id": "git.push",
      "title": "Git: Push",
      "category": "Git",
      "icon": "push"
    },
    {
      "id": "git.force-push",
      "title": "Git: Force-Push (with lease)",
      "category": "Git",
      "icon": "push"
    },
    {
      "id": "git.pull",
      "title": "Git: Pull",
      "category": "Git",
      "icon": "pull"
    },
    {
      "id": "git.fetch",
      "title": "Git: Fetch",
      "category": "Git",
      "icon": "cloud-download"
    },
    {
      "id": "git.sync",
      "title": "Git: Sync (Pull & Push)",
      "category": "Git",
      "icon": "arrow-up-down"
    },
    {
      "id": "git.checkout",
      "title": "Git: Checkout Branch…",
      "category": "Git",
      "icon": "git-branch"
    },
    {
      "id": "git.create-branch",
      "title": "Git: Create Branch…",
      "category": "Git",
      "icon": "git-branch-plus"
    },
    {
      "id": "git.merge",
      "title": "Git: Merge Branch…",
      "category": "Git",
      "icon": "git-merge"
    },
    {
      "id": "git.rebase",
      "title": "Git: Rebase onto Branch…",
      "category": "Git",
      "icon": "git-compare"
    },
    {
      "id": "git.create-tag",
      "title": "Git: Create Tag…",
      "category": "Git",
      "icon": "tag"
    },
    {
      "id": "git.stash",
      "title": "Git: Create Stash…",
      "category": "Git",
      "icon": "archive"
    },
    {
      "id": "git.stash-pop",
      "title": "Git: Pop Latest Stash",
      "category": "Git",
      "icon": "archive"
    },
    {
      "id": "git.init",
      "title": "Git: Initialize Repository",
      "category": "Git",
      "icon": "plus"
    },
    {
      "id": "git.clone",
      "title": "Git: Clone Repository…",
      "category": "Git",
      "icon": "download"
    },
    {
      "id": "git.file-history",
      "title": "Git: History of Active File",
      "category": "Git",
      "icon": "history"
    },
    {
      "id": "git.blame",
      "title": "Git: Blame of Active File",
      "category": "Git",
      "icon": "user"
    },
    {
      "id": "git.open-terminal",
      "title": "Git: Open Terminal in Repository",
      "category": "Git",
      "icon": "terminal"
    }
  ]
}
