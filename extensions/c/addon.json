{
  "languages": [
    {
      "id": "c",
      "name": "C",
      "extensions": [
        ".c",
        ".h"
      ],
      "icon": "C",
      "color": "#5c6bc0",
      "comments": {
        "line": "//",
        "block": [
          "/*",
          "*/"
        ]
      },
      "controls": [
        "if",
        "else",
        "for",
        "while",
        "do",
        "switch",
        "case",
        "default",
        "break",
        "continue",
        "return",
        "goto"
      ],
      "keywords": [
        "struct",
        "union",
        "enum",
        "typedef",
        "sizeof",
        "static",
        "extern",
        "const",
        "volatile",
        "register",
        "inline",
        "restrict",
        "_Atomic",
        "_Static_assert",
        "alignof",
        "alignas",
        "typeof"
      ],
      "types": [
        "void",
        "char",
        "short",
        "int",
        "long",
        "float",
        "double",
        "signed",
        "unsigned",
        "size_t",
        "ssize_t",
        "ptrdiff_t",
        "bool",
        "_Bool",
        "FILE",
        "int8_t",
        "int16_t",
        "int32_t",
        "int64_t",
        "uint8_t",
        "uint16_t",
        "uint32_t",
        "uint64_t",
        "intptr_t",
        "uintptr_t",
        "wchar_t",
        "time_t",
        "clock_t",
        "off_t",
        "pid_t",
        "va_list",
        "errno_t",
        "pthread_t",
        "pthread_mutex_t",
        "atomic_int",
        "jmp_buf"
      ],
      "builtins": [
        "printf",
        "fprintf",
        "sprintf",
        "snprintf",
        "scanf",
        "malloc",
        "calloc",
        "realloc",
        "free",
        "memcpy",
        "memset",
        "memmove",
        "strlen",
        "strcmp",
        "strcpy",
        "strncpy",
        "strcat",
        "fopen",
        "fclose",
        "fread",
        "fwrite",
        "exit"
      ],
      "constants": [
        "NULL",
        "true",
        "false",
        "EOF",
        "stdin",
        "stdout",
        "stderr"
      ],
      "strings": [
        {
          "start": "\"",
          "escapes": true
        },
        {
          "start": "'",
          "escapes": true
        }
      ],
      "meta": "^#\\s*[a-z]+",
      "snippets": [
        {
          "label": "main",
          "detail": "main function",
          "body": "#include <stdio.h>\n\nint main(int argc, char **argv) {\n  $0\n  return 0;\n}"
        },
        {
          "label": "inc",
          "detail": "Include",
          "body": "#include <${stdio.h}>"
        },
        {
          "label": "fori",
          "detail": "for loop",
          "body": "for (int i = 0; i < ${n}; i++) {\n  $0\n}"
        },
        {
          "label": "guard",
          "detail": "Header guard",
          "body": "#ifndef ${NAME_H}\n#define ${NAME_H}\n\n$0\n\n#endif  /* ${NAME_H} */"
        },
        {
          "label": "struct",
          "detail": "Struct with typedef",
          "body": "typedef struct {\n  ${int} ${feld};\n} ${Name};$0"
        },
        {
          "label": "enum",
          "detail": "Enum",
          "body": "typedef enum {\n  ${EINS},\n  ${ZWEI},\n} ${Name};$0"
        },
        {
          "label": "malloc",
          "detail": "Allocate memory",
          "body": "${Typ} *${name} = malloc(${n} * sizeof(*${name}));\nif (!${name}) return ${-1};$0"
        },
        {
          "label": "fopen",
          "detail": "Read a file",
          "body": "FILE *f = fopen(\"${datei}\", \"r\");\nif (!f) { perror(\"${datei}\"); return 1; }\n$0\nfclose(f);"
        },
        {
          "label": "switch",
          "detail": "switch",
          "body": "switch (${wert}) {\n  case ${1}:\n    $0\n    break;\n  default:\n    break;\n}"
        }
      ],
      "run": [
        {
          "label": "gcc",
          "command": "gcc",
          "args": [
            "${file}",
            "-o",
            "${fileStem}",
            "-Wall"
          ],
          "then": {
            "command": "./${fileStem}",
            "args": []
          }
        },
        {
          "label": "clang",
          "command": "clang",
          "args": [
            "${file}",
            "-o",
            "${fileStem}",
            "-Wall"
          ],
          "then": {
            "command": "./${fileStem}",
            "args": []
          }
        },
        {
          "label": "make",
          "command": "make",
          "args": []
        }
      ],
      "lsp": [
        {
          "label": "clangd",
          "command": "clangd",
          "args": [
            "--background-index",
            "--limit-results=0",
            "--clang-tidy",
            "--header-insertion=iwyu",
            "--completion-style=detailed",
            "--function-arg-placeholders=1",
            "--all-scopes-completion",
            "--pch-storage=memory",
            "--log=error"
          ],
          "initializationOptions": {
            "fallbackFlags": [
              "-Wall",
              "-Wextra"
            ]
          },
          "candidates": [
            "~/.local/share/nvim/mason/bin/clangd",
            "/usr/lib/llvm-19/bin/clangd",
            "/usr/lib/llvm-18/bin/clangd",
            "/usr/lib/llvm-17/bin/clangd",
            "/opt/homebrew/opt/llvm/bin/clangd",
            "/usr/local/opt/llvm/bin/clangd",
            "/Library/Developer/CommandLineTools/usr/bin/clangd",
            "C:/Program Files/LLVM/bin/clangd.exe"
          ],
          "languageId": "c",
          "rootMarkers": [
            "compile_commands.json",
            "compile_flags.txt",
            ".clangd",
            "CMakeLists.txt",
            "Makefile",
            "meson.build",
            ".git"
          ],
          "install": "Arch: pacman -S clang · Debian/Ubuntu: apt install clangd · macOS: brew install llvm (or Xcode CLT)",
          "package": {
            "type": "github",
            "repo": "clangd/clangd",
            "assets": {
              "linux-x64": "^clangd-linux-[\\d.]+\\.zip$",
              "darwin-x64": "^clangd-mac-[\\d.]+\\.zip$",
              "darwin-arm64": "^clangd-mac-[\\d.]+\\.zip$",
              "win32-x64": "^clangd-windows-[\\d.]+\\.zip$"
            }
          },
          "systemPackages": {
            "pacman": "clang",
            "apt": "clangd",
            "dnf": "clang-tools-extra",
            "zypper": "clang-tools",
            "apk": "clang-extra-tools",
            "xbps": "clang-tools-extra",
            "brew": "llvm",
            "winget": "LLVM.LLVM",
            "scoop": "llvm",
            "choco": "llvm"
          },
          "docs": "https://clangd.llvm.org"
        },
        {
          "label": "ccls",
          "command": "ccls",
          "args": [],
          "languageId": "c",
          "rootMarkers": [
            "compile_commands.json",
            ".ccls",
            ".git"
          ],
          "initializationOptions": {
            "cache": {
              "directory": "${dataDir}"
            }
          },
          "install": "https://github.com/MaskRay/ccls",
          "docs": "https://github.com/MaskRay/ccls",
          "systemPackages": {
            "pacman": "ccls",
            "apt": "ccls",
            "dnf": "ccls",
            "brew": "ccls"
          }
        }
      ],
      "debug": [
        "lldb-dap",
        "gdb-dap",
        "codelldb"
      ]
    }
  ],
  "themes": [],
  "commands": [],
  "events": [],
  "templates": [],
  "projectKinds": [],
  "snippets": []
}
