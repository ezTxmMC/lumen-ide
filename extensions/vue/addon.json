          "body": "<${li} v-for=\"${element} in ${liste}\" :key=\"${element}.id\">$0</${li}>"
        },
        {
          "label": "vif",
          "detail": "v-if/v-else",
          "body": "<div v-if=\"${bedingung}\">$0</div>\n<div v-else></div>"
