        {
          "label": "vmodel",
          "detail": "v-model",
          "body": "<input v-model=\"${wert}\" />$0"
        },
        {
          "label": "slot",
          "detail": "Slot",
          "body": "<slot name=\"${default}\">$0</slot>"
        },
        {
          "label": "style",
          "detail": "Scoped Style",
          "body": "<style scoped>\n$0\n</style>"
