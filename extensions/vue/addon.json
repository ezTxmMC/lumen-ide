          "label": "sfc",
          "detail": "Single-File-Komponente",
          "body": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst ${counter} = ref(0)\n</script>\n\n<template>\n  <button @click=\"${counter}++\">{{ ${counter} }}</button>$0\n</template>\n\n<style scoped>\n</style>"
        },
        {
          "label": "script",
          "detail": "script setup",
          "body": "<script setup lang=\"ts\">\n$0\n</script>"
        },
        {
          "label": "props",
          "detail": "defineProps",
          "body": "const props = defineProps<{\n  ${titel}: ${string}\n  ${anzahl}?: ${number}\n}>()$0"
