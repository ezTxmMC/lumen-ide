          "body": "const ${wert} = ref(${0})$0"
        },
        {
          "label": "comp",
          "detail": "computed",
          "body": "const ${wert} = computed(() => $0)"
        },
        {
          "label": "watch",
          "detail": "watch",
          "body": "watch(${quelle}, (neu, alt) => {\n  $0\n})"
        },
        {
          "label": "mounted",
          "detail": "onMounted",
          "body": "onMounted(() => {\n  $0\n})"
        },
        {
          "label": "vfor",
