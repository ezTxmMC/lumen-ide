{
  "id": "ext.github",
  "name": "GitHub",
  "version": "1.0.1",
  "description": "Pull requests, issues and GitHub Actions of the open repository: check out, review, merge, create, re-run workflows and the CI status in the status bar. Ships with program code.",
  "author": "Lumen",
  "icon": "GH",
  "color": "#8b949e",
  "category": "tool",
  "license": "MIT",
  "keywords": [
    "github",
    "pull request",
    "issues",
    "actions",
    "ci",
    "gh"
  ],
  "minAppVersion": "0.5.0",
  "settings": [
    {
      "key": "token",
      "label": "Personal Access Token",
      "type": "secret",
      "hint": "Stored encrypted in the system keychain. Alternatively: GitHub: Sign In… in the command palette.",
      "section": "Sign-in"
    },
    {
      "key": "useGhCli",
      "label": "Use the GitHub CLI sign-in",
      "type": "toggle",
      "default": "true",
      "hint": "Without a token of your own, “gh auth token” is asked when the GitHub CLI is installed.",
      "section": "Sign-in"
    },
    {
      "key": "apiUrl",
      "label": "API address",
      "type": "text",
      "default": "",
      "placeholder": "https://api.github.com",
      "hint": "Only for GitHub Enterprise, e.g. https://github.example.com/api/v3.",
      "section": "Server"
    }
  ],
  "views": [
    {
      "id": "pulls",
      "title": "Pull Requests",
      "icon": "git-pull-request",
      "location": "right",
      "order": 20
    },
    {
      "id": "issues",
      "title": "Issues",
      "icon": "circle-dot",
      "location": "right",
      "order": 21
    },
    {
      "id": "actions",
      "title": "GitHub Actions",
      "icon": "workflow",
      "location": "bottom",
      "order": 71
    }
  ],
  "commands": [
    {
      "id": "github.refresh",
      "title": "GitHub: Refresh",
      "category": "GitHub",
      "icon": "refresh-cw"
    },
    {
      "id": "github.open-repo",
      "title": "GitHub: Open Repository in Browser",
      "category": "GitHub",
      "icon": "github"
    },
    {
      "id": "github.open-file",
      "title": "GitHub: Open Active File on GitHub",
      "category": "GitHub",
      "icon": "external-link"
    },
    {
      "id": "github.create-pr",
      "title": "GitHub: Create Pull Request…",
      "category": "GitHub",
      "icon": "git-pull-request-arrow"
    },
    {
      "id": "github.create-issue",
      "title": "GitHub: Create Issue…",
      "category": "GitHub",
      "icon": "circle-dot"
    },
    {
      "id": "github.sign-in",
      "title": "GitHub: Sign In…",
      "category": "GitHub",
      "icon": "log-in"
    },
    {
      "id": "github.sign-out",
      "title": "GitHub: Sign Out",
      "category": "GitHub",
      "icon": "log-out"
    },
    {
      "id": "github.open-pulls",
      "title": "GitHub: Show Pull Requests",
      "category": "GitHub",
      "icon": "git-pull-request"
    },
    {
      "id": "github.open-issues",
      "title": "GitHub: Show Issues",
      "category": "GitHub",
      "icon": "circle-dot"
    },
    {
      "id": "github.open-actions",
      "title": "GitHub: Show Actions",
      "category": "GitHub",
      "icon": "workflow"
    }
  ]
}
