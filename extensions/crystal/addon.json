{
  "languages": [
    {
      "id": "crystal",
      "name": "Crystal",
      "extensions": [
        ".cr"
      ],
      "filenames": [
        "shard.yml"
      ],
      "icon": "Cr",
      "color": "#c8c8c8",
      "capitalizedAsType": true,
      "comments": {
        "line": "#"
      },
      "controls": [
        "if",
        "elsif",
        "else",
        "unless",
        "case",
        "when",
        "in",
        "while",
        "until",
        "for",
        "break",
        "next",
        "return",
        "begin",
        "rescue",
        "ensure",
        "raise",
        "yield",
        "then",
        "end"
      ],
      "keywords": [
        "def",
        "class",
        "module",
        "struct",
        "enum",
        "lib",
        "fun",
        "macro",
        "alias",
        "abstract",
        "private",
        "protected",
        "require",
        "include",
        "extend",
        "of",
        "as",
        "is_a?",
        "responds_to?",
        "nil?",
        "typeof",
        "sizeof",
        "instance_sizeof",
        "pointerof",
        "out",
        "with",
        "self",
        "super",
        "uninitialized",
        "annotation",
        "select",
        "spawn",
        "property",
        "getter",
        "setter",
        "record"
      ],
      "types": [
        "Int8",
        "Int16",
        "Int32",
        "Int64",
        "Int128",
        "UInt8",
        "UInt16",
        "UInt32",
        "UInt64",
        "Float32",
        "Float64",
        "Bool",
        "Char",
        "String",
        "Symbol",
        "Array",
        "Hash",
        "Set",
        "Tuple",
        "NamedTuple",
        "Range",
        "Proc",
        "Nil",
        "Object",
        "Slice",
        "Pointer",
        "Channel",
        "Fiber",
        "Exception",
        "JSON",
        "YAML",
        "IO"
      ],
      "builtins": [
        "puts",
        "print",
        "p",
        "pp",
        "gets",
        "raise",
        "loop",
        "sleep",
        "rand",
        "abort",
        "exit",
        "each",
        "map",
        "select",
        "reject",
        "reduce",
        "sum",
        "size",
        "to_s",
        "to_i",
        "to_f",
        "new"
      ],
      "constants": [
        "true",
        "false",
        "nil",
        "__FILE__",
        "__LINE__",
        "__DIR__"
      ],
      "strings": [
        {
          "start": "\"",
          "multiline": true,
          "escapes": true,
          "interpolate": "#{"
        },
        {
          "start": "'",
          "escapes": true
        },
        {
          "start": "%w(",
          "end": ")",
          "escapes": false
        }
      ],
      "identifier": "^[A-Za-z_][\\w]*[?!]?",
      "operators": "^(?:<=>|===|=~|\\*\\*|\\|>|&&|\\|\\||\\.\\.\\.|\\.\\.|[+\\-*/%=<>!&|^~?:@])",
      "meta": "^@\\[[^\\]]*\\]",
      "indentOpen": "(?:\\b(?:def|class|module|struct|enum|do|if|unless|while|until|case|begin)\\b.*|[{[(]|\\bdo\\b(?:\\s*\\|[^|]*\\|)?)\\s*$",
      "indentClose": "^\\s*(?:end|else|elsif|when|rescue|ensure|\\}|\\]|\\))",
      "snippets": [
        {
          "label": "def",
          "detail": "Methode",
          "body": "def ${name}(${args})\n  $0\nend"
        },
        {
          "label": "class",
          "detail": "Klasse",
          "body": "class ${Name}\n  def initialize\n    $0\n  end\nend"
        },
        {
          "label": "struct",
          "detail": "Struct",
          "body": "struct ${Name}\n  getter ${feld} : ${String}\n\n  def initialize(@${feld} : ${String})\n  end\nend"
        },
        {
          "label": "module",
          "detail": "Modul",
          "body": "module ${Name}\n  $0\nend"
        },
        {
          "label": "enum",
          "detail": "Enum",
          "body": "enum ${Name}\n  ${Eins}\n  ${Zwei}$0\nend"
        },
        {
          "label": "record",
          "detail": "record",
          "body": "record ${Name}, ${feld} : ${String}$0"
        },
        {
          "label": "each",
          "detail": "each",
          "body": "${liste}.each do |${element}|\n  $0\nend"
        },
        {
          "label": "map",
          "detail": "map",
          "body": "${liste}.map { |${element}| $0 }"
        },
        {
          "label": "case",
          "detail": "case/when",
          "body": "case ${wert}\nwhen ${muster}\n  $0\nelse\n  nil\nend"
        },
        {
          "label": "begin",
          "detail": "begin/rescue",
          "body": "begin\n  $0\nrescue ex : ${Exception}\n  puts ex.message\nend"
        },
        {
          "label": "spawn",
          "detail": "Fiber",
          "body": "spawn do\n  $0\nend"
        },
        {
          "label": "json",
          "detail": "JSON-Serialisierung",
          "body": "struct ${Name}\n  include JSON::Serializable\n\n  getter ${feld} : ${String}$0\nend"
        },
        {
          "label": "spec",
          "detail": "Spec",
          "body": "describe ${Name} do\n  it \"${tut etwas}\" do\n    $0\n  end\nend"
        }
      ],
      "run": [
        {
          "label": "crystal run",
          "command": "crystal",
          "args": [
            "run",
            "${file}"
          ]
        },
        {
          "label": "crystal build",
          "command": "crystal",
          "args": [
            "build",
            "--release",
            "${file}"
          ]
        },
        {
          "label": "crystal spec",
          "command": "crystal",
          "args": [
            "spec"
          ]
        },
        {
          "label": "crystal tool format",
          "command": "crystal",
          "args": [
            "tool",
            "format"
          ]
        }
      ],
      "lsp": [
        {
          "label": "crystalline",
          "command": "crystalline",
          "args": [
            "--stdio"
          ],
          "languageId": "crystal",
          "rootMarkers": [
            "shard.yml",
            ".git"
          ],
          "install": "https://github.com/elbywan/crystalline",
          "package": {
            "type": "github",
            "repo": "elbywan/crystalline",
            "assets": {
              "linux-x64": "^crystalline_x86_64-unknown-linux-musl\\.gz$",
              "darwin-x64": "^crystalline_x86_64-apple-darwin\\.gz$",
              "darwin-arm64": "^crystalline_arm64-apple-darwin\\.gz$"
            }
          },
          "systemPackages": {
            "brew": "crystalline"
          }
        },
        {
          "label": "scry",
          "command": "scry",
          "args": [],
          "languageId": "crystal",
          "rootMarkers": [
            "shard.yml",
            ".git"
          ],
          "install": "https://github.com/crystal-lang-tools/scry"
        }
      ],
      "debug": [
        "lldb-dap",
        "gdb-dap",
        "codelldb"
      ]
    }
  ],
  "themes": [],
  "commands": [],
  "events": [],
  "templates": [
    {
      "id": "crystal-shards",
      "name": "templates.lang.crystalName",
      "description": "templates.lang.crystalDescription",
      "languageId": "crystal",
      "kindId": "shards",
      "icon": "Cr",
      "color": "#000100",
      "fields": [
        {
          "id": "version",
          "label": "templates.fields.version",
          "default": "0.1.0",
          "pattern": "\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?",
          "patternHint": "templates.fields.versionHint",
          "section": "templates.sections.project",
          "mono": true
        },
        {
          "id": "description",
          "label": "templates.fields.description",
          "placeholder": "templates.fields.descriptionPlaceholder",
          "required": false,
          "section": "templates.sections.project"
        },
        {
          "id": "author",
          "label": "templates.fields.author",
          "placeholder": "templates.fields.authorPlaceholder",
          "required": false,
          "section": "templates.sections.project"
        },
        {
          "id": "license",
          "label": "templates.fields.license",
          "type": "select",
          "choices": [
            {
              "value": "MIT",
              "label": "MIT"
            },
            {
              "value": "Apache-2.0",
              "label": "Apache 2.0"
            },
            {
              "value": "GPL-3.0-or-later",
              "label": "GPL 3.0"
            },
            {
              "value": "BSD-3-Clause",
              "label": "BSD 3-Clause"
            },
            {
              "value": "UNLICENSED",
              "label": "templates.fields.licenseNone"
            }
          ],
          "section": "templates.sections.project"
        },
        {
          "id": "type",
          "label": "templates.fields.type",
          "type": "select",
          "choices": [
            {
              "value": "app",
              "label": "templates.fields.application"
            },
            {
              "value": "lib",
              "label": "templates.fields.library"
            }
          ],
          "section": "templates.sections.build"
        }
      ],
      "open": "src/{{slug|snake}}.cr",
      "setup": [
        {
          "label": "shards install",
          "command": "shards",
          "args": [
            "install"
          ]
        }
      ],
      "files": [
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "MIT"
            },
            {
              "field": "type",
              "equals": "app"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ntargets:\n  {{slug}}:\n    main: src/{{slug|snake}}.cr\n\ncrystal: '>= 1.14.0'\nlicense: MIT\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "MIT"
            },
            {
              "field": "type",
              "equals": "lib"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ncrystal: '>= 1.14.0'\nlicense: MIT\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "Apache-2.0"
            },
            {
              "field": "type",
              "equals": "app"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ntargets:\n  {{slug}}:\n    main: src/{{slug|snake}}.cr\n\ncrystal: '>= 1.14.0'\nlicense: Apache-2.0\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "Apache-2.0"
            },
            {
              "field": "type",
              "equals": "lib"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ncrystal: '>= 1.14.0'\nlicense: Apache-2.0\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "GPL-3.0-or-later"
            },
            {
              "field": "type",
              "equals": "app"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ntargets:\n  {{slug}}:\n    main: src/{{slug|snake}}.cr\n\ncrystal: '>= 1.14.0'\nlicense: GPL-3.0-or-later\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "GPL-3.0-or-later"
            },
            {
              "field": "type",
              "equals": "lib"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ncrystal: '>= 1.14.0'\nlicense: GPL-3.0-or-later\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "BSD-3-Clause"
            },
            {
              "field": "type",
              "equals": "app"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ntargets:\n  {{slug}}:\n    main: src/{{slug|snake}}.cr\n\ncrystal: '>= 1.14.0'\nlicense: BSD-3-Clause\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "BSD-3-Clause"
            },
            {
              "field": "type",
              "equals": "lib"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ncrystal: '>= 1.14.0'\nlicense: BSD-3-Clause\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "UNLICENSED"
            },
            {
              "field": "type",
              "equals": "app"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ntargets:\n  {{slug}}:\n    main: src/{{slug|snake}}.cr\n\ncrystal: '>= 1.14.0'\n"
        },
        {
          "path": "shard.yml",
          "when": [
            {
              "field": "license",
              "equals": "UNLICENSED"
            },
            {
              "field": "type",
              "equals": "lib"
            }
          ],
          "content": "name: {{slug}}\nversion: {{version}}\ndescription: {{description}}\nauthors:\n  - {{author}}\n\ncrystal: '>= 1.14.0'\n"
        },
        {
          "path": "src/{{slug|snake}}.cr",
          "when": {
            "field": "type",
            "equals": "app"
          },
          "content": "module {{slug|pascal}}\n  VERSION = \"{{version}}\"\n\n  def self.greet(name : String) : String\n    \"Hello, #{name}!\"\n  end\nend\n\nputs {{slug|pascal}}.greet(\"{{name}}\")\n"
        },
        {
          "path": "src/{{slug|snake}}.cr",
          "when": {
            "field": "type",
            "equals": "lib"
          },
          "content": "module {{slug|pascal}}\n  VERSION = \"{{version}}\"\n\n  def self.greet(name : String) : String\n    \"Hello, #{name}!\"\n  end\nend\n"
        },
        {
          "path": "spec/{{slug|snake}}_spec.cr",
          "content": "require \"./spec_helper\"\n\ndescribe {{slug|pascal}} do\n  it \"greets\" do\n    {{slug|pascal}}.greet(\"World\").should eq(\"Hello, World!\")\n  end\nend\n"
        },
        {
          "path": "spec/spec_helper.cr",
          "content": "require \"spec\"\nrequire \"../src/{{slug|snake}}\"\n"
        },
        {
          "path": ".editorconfig",
          "content": "root = true\n\n[*.cr]\nindent_style = space\nindent_size = 2\n"
        },
        {
          "path": ".gitignore",
          "content": "lib/\nbin/\n.shards/\n.lumen/\n"
        },
        {
          "path": "README.md",
          "when": {
            "field": "type",
            "equals": "app"
          },
          "content": "# {{name}}\n\n```bash\nshards install\nshards run {{slug}}\ncrystal spec\n```\n"
        },
        {
          "path": "README.md",
          "when": {
            "field": "type",
            "equals": "lib"
          },
          "content": "# {{name}}\n\n```bash\nshards install\ncrystal spec\n```\n"
        }
      ]
    }
  ],
  "projectKinds": [
    {
      "id": "shards",
      "name": "Shards",
      "icon": "Cr",
      "color": "#000100",
      "markers": [
        "shard.yml"
      ],
      "priority": 10,
      "languageIds": [
        "crystal"
      ],
      "buildFile": "shard.yml",
      "sourceRoots": [
        "src",
        "spec"
      ],
      "tasks": [
        {
          "id": "install",
          "label": "templates.tasks.installDeps",
          "command": "shards",
          "args": [
            "install"
          ],
          "group": "build"
        },
        {
          "id": "build",
          "label": "templates.tasks.build",
          "command": "shards",
          "args": [
            "build"
          ],
          "group": "build"
        },
        {
          "id": "run",
          "label": "templates.tasks.run",
          "command": "shards",
          "args": [
            "run"
          ],
          "group": "run",
          "forEachMatch": {
            "file": "shard.yml",
            "block": "targets",
            "pattern": "^ {2}([\\w-]+):",
            "label": "templates.tasks.runTarget",
            "singleLabel": "templates.tasks.run",
            "args": [
              "run",
              "{match}"
            ],
            "limit": 4,
            "omitWhenEmpty": true
          }
        },
        {
          "id": "spec",
          "label": "Specs",
          "command": "crystal",
          "args": [
            "spec"
          ],
          "group": "test"
        },
        {
          "id": "update",
          "label": "templates.tasks.updateDeps",
          "command": "shards",
          "args": [
            "update"
          ],
          "group": "other"
        },
        {
          "id": "format",
          "label": "templates.tasks.format",
          "command": "crystal",
          "args": [
            "tool",
            "format"
          ],
          "group": "other"
        }
      ],
      "facts": [
        {
          "label": "Name",
          "file": "shard.yml",
          "pattern": "^name:\\s*(\\S+)",
          "role": "name"
        },
        {
          "label": "Version",
          "file": "shard.yml",
          "pattern": "^version:\\s*(\\S+)",
          "role": "version"
        },
        {
          "label": "Beschreibung",
          "file": "shard.yml",
          "pattern": "^description:\\s*(.+)$",
          "role": "description"
        },
        {
          "label": "Crystal",
          "file": "shard.yml",
          "pattern": "^crystal:\\s*['\\\"]?([^'\\\"\\n]+)"
        }
      ],
      "dependencyScan": [
        {
          "file": "shard.yml",
          "block": "dependencies",
          "scope": "dependencies",
          "pattern": "^ {2}([\\w-]+):\\s*\\n(?:\\s{4}.*\\n?)*",
          "versionPattern": "version:\\s*(.+)"
        },
        {
          "file": "shard.yml",
          "block": "development_dependencies",
          "scope": "development_dependencies",
          "pattern": "^ {2}([\\w-]+):\\s*\\n(?:\\s{4}.*\\n?)*",
          "versionPattern": "version:\\s*(.+)"
        }
      ],
      "dependencies": {
        "manager": "Shards",
        "placeholder": "kemalcr/kemal",
        "hint": "templates.lang.shardsHint",
        "scopes": [
          {
            "value": "dependencies",
            "label": "dependencies"
          },
          {
            "value": "development_dependencies",
            "label": "development_dependencies"
          }
        ],
        "edit": {
          "file": "shard.yml",
          "sectionPattern": "^{scope}:\\s*$",
          "sectionHeader": "{scope}:",
          "indent": "  ",
          "lines": [
            "{short}:",
            "  github: {name}",
            "  version: {version}"
          ],
          "then": {
            "id": "shards:install",
            "label": "shards install",
            "command": "shards",
            "args": [
              "install"
            ]
          }
        }
      }
    }
  ],
  "snippets": []
}
