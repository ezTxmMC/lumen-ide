          "label": "cpp",
          "detail": "C++-Build",
          "body": "FROM gcc:14 AS build\nWORKDIR /src\nCOPY . .\nRUN cmake -S . -B build && cmake --build build\n\nFROM debian:bookworm-slim\nCOPY --from=build /src/build/${app} /usr/local/bin/${app}\nCMD [\"${app}\"]$0"
        }
