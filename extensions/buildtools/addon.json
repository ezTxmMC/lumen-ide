        },
        {
          "label": "node",
          "detail": "Node-Image",
          "body": "FROM node:22-alpine\nWORKDIR /app\nCOPY package*.json ./\nRUN npm ci\nCOPY . .\nCMD [\"node\", \"src/index.js\"]$0"
        },
