      "snippets": [
        {
          "label": "project",
          "detail": "Grundgerüst",
          "body": "cmake_minimum_required(VERSION 3.20)\nproject(${name} VERSION 0.1.0 LANGUAGES CXX)\n\nset(CMAKE_CXX_STANDARD 20)\nset(CMAKE_EXPORT_COMPILE_COMMANDS ON)\n\nadd_executable(${name} src/main.cpp)$0"
        },
        {
          "label": "exe",
          "detail": "add_executable",
          "body": "add_executable(${ziel} ${quellen})$0"
        },
        {
          "label": "lib",
          "detail": "add_library",
          "body": "add_library(${ziel} STATIC ${quellen})$0"
        },
        {
          "label": "link",
          "detail": "target_link_libraries",
          "body": "target_link_libraries(${ziel} PRIVATE ${bibliothek})$0"
        },
        {
          "label": "inc",
          "detail": "target_include_directories",
          "body": "target_include_directories(${ziel} PUBLIC include)$0"
        },
        {
          "label": "find",
          "detail": "find_package",
          "body": "find_package(${Paket} REQUIRED)$0"
        },
        {
          "label": "fetch",
          "detail": "FetchContent",
          "body": "include(FetchContent)\nFetchContent_Declare(\n  ${name}\n  GIT_REPOSITORY ${url}\n  GIT_TAG ${tag}\n)\nFetchContent_MakeAvailable(${name})$0"
        },
        {
          "label": "opt",
          "detail": "option",
          "body": "option(${NAME} \"${Beschreibung}\" OFF)$0"
        },
        {
          "label": "test",
          "detail": "add_test",
          "body": "enable_testing()\nadd_test(NAME ${name} COMMAND ${ziel})$0"
        }
