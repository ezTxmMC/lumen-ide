        {
          "label": "cproj",
          "detail": "C-Grundgerüst",
          "body": "CC ?= cc\nCFLAGS ?= -std=c17 -Wall -Wextra -g\nSRC := $(wildcard src/*.c)\nOBJ := $(SRC:.c=.o)\n\nall: ${app}\n\n${app}: $(OBJ)\n\t$(CC) -o $@ $^\n\nclean:\n\trm -f $(OBJ) ${app}\n\n.PHONY: all clean$0"
        }
